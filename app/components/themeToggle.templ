package components

import "github.com/AslanSN/CurriculumVitae/i18n"

// ThemeToggle is an icon-only button that flips the colour theme. It calls the
// global window.__toggleTheme() (defined in the <head> theme script), so it works
// before Alpine loads and needs no per-instance state. Which glyph shows — sun in
// dark, moon in light — is driven purely by CSS off :root[data-theme] (see
// input.css), so the same component can appear in both the navbar and the mobile
// drawer without a duplicate id. Icons inherit currentColor, so they follow the ink.
templ ThemeToggle(d i18n.Dict) {
	<button
		type="button"
		onclick="window.__toggleTheme()"
		aria-label={ d.ThemeToggle }
		title={ d.ThemeToggle }
		class="theme-toggle btn-ghost-e cursor-pointer px-2.5"
	>
		<svg class="icon-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
		</svg>
		<svg class="icon-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
		</svg>
	</button>
}
